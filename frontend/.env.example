# Copy to ".env.local". In production (Vercel), point this at your
# deployed backend URL, including /api.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Create a GitHub OAuth App with callback URL:
# http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Must be the same value as backend API_TOKEN_SECRET.
API_TOKEN_SECRET=
