# ────────────────────────────────────────────────────────────
# AudioSnap backend – environment configuration
# Copy this file to ".env" and fill in real values.
# ────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Database (PostgreSQL via Prisma)
# Local Docker example from the README; replace it with your provider URL when deploying.
DATABASE_URL=postgresql://audiosnap:audiosnap-local@localhost:5432/audiosnap?schema=public

# Redis (used by BullMQ for the conversion/trim job queue)
REDIS_URL=redis://localhost:6379
# Generate a random secret and use the same value in the frontend and backend environments.
API_TOKEN_SECRET=

# Filesystem
# Folder used for downloaded source media + converted output before cleanup.
TMP_DIR=./tmp
# Max age (minutes) before a temp file is force-deleted by the cleanup service.
TMP_FILE_TTL_MINUTES=60

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# Upload limits
MAX_VIDEO_DURATION_SECONDS=7200
MAX_SOURCE_SIZE_BYTES=268435456
MAX_BATCH_URLS=10

# Metadata cache TTL (seconds)
METADATA_CACHE_TTL_SECONDS=1800
